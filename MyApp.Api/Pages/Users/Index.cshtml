@page
@model MyApp.Api.Pages.Users.IndexModel
@{
    ViewData["Title"] = "使用者管理";
    ViewData["Page"] = "users";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">✅ @TempData["Success"]</div>
}

<div class="card">
    <div class="card-header">
        <h2>使用者清單（共 @Model.Users.Count 人）</h2>
        <button class="btn btn-success" onclick="document.getElementById('createModal').classList.add('show')">＋ 新增使用者</button>
    </div>

    @if (Model.Users.Count == 0)
    {
        <div class="empty">目前沒有使用者，請先新增</div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>姓名</th>
                    <th>建立時間</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr>
                        <td>@u.Id</td>
                        <td>@u.Name</td>
                        <td>@u.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                        <td>
                            <form method="post" asp-page-handler="Delete" onsubmit="return confirm('確定刪除使用者「@u.Name」？')">
                                <input type="hidden" name="id" value="@u.Id" />
                                <button type="submit" class="btn btn-danger">刪除</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="modal-overlay" id="createModal">
    <div class="modal">
        <h3>＋ 新增使用者</h3>
        <form method="post" asp-page-handler="Create">
            <div class="form-group">
                <label>姓名</label>
                <input type="text" name="Name" required placeholder="請輸入使用者姓名" autofocus />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="document.getElementById('createModal').classList.remove('show')">取消</button>
                <button type="submit" class="btn btn-success">新增</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('createModal').addEventListener('click', function(e) {
        if (e.target === this) this.classList.remove('show');
    });
</script>
}
