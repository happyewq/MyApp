<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BNI 預約資訊系統</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Arial, sans-serif; background: #f0f4f8; color: #333; display: flex; min-height: 100vh; }

        /* Sidebar */
        .sidebar {
            width: 240px; min-height: 100vh;
            background: linear-gradient(180deg, #1a56db 0%, #0e3a8a 100%);
            color: white; display: flex; flex-direction: column;
            position: fixed; top: 0; left: 0; z-index: 50;
        }
        .sidebar-logo {
            padding: 24px 20px 20px;
            border-bottom: 1px solid rgba(255,255,255,0.15);
        }
        .sidebar-logo .bni { font-size: 1.6rem; font-weight: 900; letter-spacing: 4px; }
        .sidebar-logo .sys { font-size: 0.8rem; opacity: 0.75; margin-top: 2px; }

        .sidebar-user {
            padding: 16px 20px;
            border-bottom: 1px solid rgba(255,255,255,0.15);
            font-size: 0.85rem;
        }
        .sidebar-user .name { font-weight: 600; }
        .sidebar-user .role {
            display: inline-block; margin-top: 4px;
            background: rgba(255,255,255,0.2); border-radius: 20px;
            padding: 2px 10px; font-size: 0.75rem;
        }

        .sidebar-nav { flex: 1; padding: 12px 0; }
        .nav-item {
            display: flex; align-items: center; gap: 10px;
            padding: 12px 20px; font-size: 0.92rem;
            color: rgba(255,255,255,0.8); text-decoration: none;
            transition: all 0.15s;
        }
        .nav-item:hover { background: rgba(255,255,255,0.12); color: white; }
        .nav-item.active { background: rgba(255,255,255,0.2); color: white; font-weight: 600; }
        .nav-icon { font-size: 1.1rem; width: 24px; text-align: center; }

        .sidebar-footer { padding: 16px 20px; border-top: 1px solid rgba(255,255,255,0.15); }
        .logout-btn {
            display: block; width: 100%; padding: 10px;
            background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3);
            color: white; border-radius: 8px; cursor: pointer;
            font-size: 0.88rem; text-align: center; text-decoration: none;
        }
        .logout-btn:hover { background: rgba(255,255,255,0.25); }

        /* Main content */
        .main { margin-left: 240px; flex: 1; display: flex; flex-direction: column; }
        .topbar {
            background: white; padding: 16px 28px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.08);
            font-size: 1.1rem; font-weight: 600; color: #111;
        }
        .content { padding: 28px; flex: 1; }

        /* Cards, buttons, tables (共用) */
        .btn { padding: 9px 20px; border: none; border-radius: 6px; font-size: 0.9rem; cursor: pointer; font-weight: 500; display: inline-block; text-decoration: none; }
        .btn-primary { background: #1a56db; color: white; }
        .btn-primary:hover { background: #1648c0; }
        .btn-success { background: #057a55; color: white; }
        .btn-success:hover { background: #046c4e; }
        .btn-warning { background: #e3a008; color: white; }
        .btn-warning:hover { background: #c27803; }
        .btn-danger { background: #e02424; color: white; }
        .btn-danger:hover { background: #c81e1e; }
        .btn-secondary { background: #6b7280; color: white; }
        .btn-secondary:hover { background: #4b5563; }

        .card { background: white; border-radius: 10px; box-shadow: 0 1px 4px rgba(0,0,0,0.08); overflow: hidden; }
        .card-header { padding: 16px 24px; border-bottom: 1px solid #e5e7eb; display: flex; justify-content: space-between; align-items: center; }
        .card-header h2 { font-size: 1rem; color: #111; }

        .search-bar { background: white; border-radius: 10px; padding: 20px 24px; margin-bottom: 24px; box-shadow: 0 1px 4px rgba(0,0,0,0.08); display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap; }
        .search-bar label { font-size: 0.85rem; color: #555; margin-bottom: 4px; display: block; }
        .search-bar input, .search-bar select { padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 0.9rem; min-width: 180px; }

        table { width: 100%; border-collapse: collapse; }
        th { background: #f9fafb; padding: 12px 16px; text-align: left; font-size: 0.85rem; color: #6b7280; border-bottom: 1px solid #e5e7eb; }
        td { padding: 14px 16px; border-bottom: 1px solid #f3f4f6; font-size: 0.9rem; }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: #f9fafb; }

        .badge { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 0.78rem; font-weight: 500; }
        .badge-blue { background: #e1effe; color: #1a56db; }
        .badge-green { background: #def7ec; color: #03543f; }
        .badge-gray { background: #f3f4f6; color: #374151; }

        .action-btns { display: flex; gap: 8px; }
        .empty { text-align: center; padding: 48px; color: #9ca3af; }
        .alert { padding: 12px 16px; border-radius: 6px; margin-bottom: 16px; font-size: 0.9rem; }
        .alert-success { background: #def7ec; color: #03543f; border: 1px solid #bcf0da; }
        .alert-error { background: #fde8e8; color: #9b1c1c; border: 1px solid #f8b4b4; }

        .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 100; align-items: center; justify-content: center; }
        .modal-overlay.show { display: flex; }
        .modal { background: white; border-radius: 12px; padding: 32px; width: 480px; max-width: 95vw; box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
        .modal h3 { margin-bottom: 20px; font-size: 1.1rem; color: #111; }
        .form-group { margin-bottom: 16px; }
        .form-group label { display: block; font-size: 0.85rem; color: #374151; margin-bottom: 6px; font-weight: 500; }
        .form-group input, .form-group select { width: 100%; padding: 9px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 0.9rem; }
        .form-group input:focus, .form-group select:focus { outline: none; border-color: #1a56db; box-shadow: 0 0 0 3px rgba(26,86,219,0.1); }
        .modal-footer { display: flex; justify-content: flex-end; gap: 10px; margin-top: 24px; }
    </style>
</head>
<body>

<div class="sidebar">
    <div class="sidebar-logo">
        <div class="bni">BNI</div>
        <div class="sys">預約資訊系統</div>
    </div>
    <div class="sidebar-user">
        <div class="name">👋 @Context.Session.GetString("UserName")</div>
        <span class="role">@(Context.Session.GetString("UserRole") == "admin" ? "管理員" : "一般使用者")</span>
    </div>
    <nav class="sidebar-nav">
        <a href="/Appointments" class="nav-item @(ViewData["Page"]?.ToString() == "appointments" ? "active" : "")">
            <span class="nav-icon">📅</span> 預約管理
        </a>
        <a href="/Users" class="nav-item @(ViewData["Page"]?.ToString() == "users" ? "active" : "")">
            <span class="nav-icon">👥</span> 使用者管理
        </a>
        @if (Context.Session.GetString("UserRole") == "admin")
        {
            <a href="/AccountManagement" class="nav-item @(ViewData["Page"]?.ToString() == "accounts" ? "active" : "")">
                <span class="nav-icon">🔑</span> 帳號管理
            </a>
        }
    </nav>
    <div class="sidebar-footer">
        <form method="post" action="/Appointments?handler=Logout">
            <button type="submit" class="logout-btn">🚪 登出</button>
        </form>
    </div>
</div>

<div class="main">
    <div class="topbar">@ViewData["Title"]</div>
    <div class="content">
        @RenderBody()
    </div>
</div>

@RenderSection("Scripts", required: false)
</body>
</html>
