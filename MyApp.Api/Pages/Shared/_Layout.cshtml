<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BNI 預約資訊系統</title>
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>

<!-- Desktop Sidebar -->
<div class="sidebar">
    <div class="sidebar-logo">
        <div class="bni">BNI</div>
        <div class="sys">預約資訊系統</div>
    </div>
    <div class="sidebar-user">
        <div class="avatar">@(Context.Session.GetString("UserName")?[0].ToString().ToUpper() ?? "?")</div>
        <div class="user-info">
            <div class="name">@Context.Session.GetString("UserName")</div>
            <span class="role-badge">@(Context.Session.GetString("UserRole") == "admin" ? "管理員" : "一般使用者")</span>
        </div>
    </div>
    <div class="nav-section">
        <div class="nav-label">主選單</div>
        <a href="/Appointments" class="nav-item @(ViewData["Page"]?.ToString() == "appointments" ? "active" : "")">
            <span class="nav-icon">📅</span> 預約管理
        </a>
        <a href="/Users" class="nav-item @(ViewData["Page"]?.ToString() == "users" ? "active" : "")">
            <span class="nav-icon">👥</span> 使用者管理
        </a>
        @if (Context.Session.GetString("UserRole") == "admin")
        {
            <div class="nav-label" style="margin-top:16px;">系統管理</div>
            <a href="/AccountManagement" class="nav-item @(ViewData["Page"]?.ToString() == "accounts" ? "active" : "")">
                <span class="nav-icon">🔑</span> 帳號管理
            </a>
        }
    </div>
    <div class="sidebar-footer">
        <a href="/Logout" class="logout-btn"><span>🚪</span> 登出系統</a>
    </div>
</div>

<div class="main">
    <div class="topbar">
        <div class="topbar-title">@ViewData["Title"]</div>
        <div class="mobile-user-chip">
            <div class="mobile-avatar">@(Context.Session.GetString("UserName")?[0].ToString().ToUpper() ?? "?")</div>
            <span class="mobile-user-name">@Context.Session.GetString("UserName")</span>
        </div>
    </div>
    <div class="content">
        @RenderBody()
    </div>
</div>

<!-- Mobile Bottom Nav -->
<nav class="bottom-nav">
    <a href="/Appointments" class="@(ViewData["Page"]?.ToString() == "appointments" ? "active" : "")">
        <span class="bn-icon">📅</span>
        <span class="bn-label">預約</span>
    </a>
    <a href="/Users" class="@(ViewData["Page"]?.ToString() == "users" ? "active" : "")">
        <span class="bn-icon">👥</span>
        <span class="bn-label">使用者</span>
    </a>
    @if (Context.Session.GetString("UserRole") == "admin")
    {
        <a href="/AccountManagement" class="@(ViewData["Page"]?.ToString() == "accounts" ? "active" : "")">
            <span class="bn-icon">🔑</span>
            <span class="bn-label">帳號</span>
        </a>
    }
    <a href="/Logout">
        <span class="bn-icon">🚪</span>
        <span class="bn-label">登出</span>
    </a>
</nav>

<script src="/js/app.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
